---
// src/pages/worldcup/players/[player].astro
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import TeamCard from '../../../components/worldcup/TeamCard.astro';
import { teams, getRankSummary } from '../../../data/worldcup/teams';
import { matches } from '../../../data/worldcup/matches';
import { calculatePlayerScore } from '../../../data/worldcup/scoring';
import type { Player } from '../../../data/worldcup/teams';
import Country from '../../../components/worldcup/Country.astro';

// 1. Tell Astro which routes to generate at build time
export function getStaticPaths() {
  return [
    { params: { player: 'keenan' } },
    { params: { player: 'poppie' } },
  ];
}

// 2. Get the current player from the URL and format the name
const { player } = Astro.params;
const playerName = (player.charAt(0).toUpperCase() + player.slice(1)) as Player;

// 3. Fetch data specific to this player and sort by Tournament Rank
const myTeams = teams
	.filter(t => t.owner === playerName)
	.sort((a, b) => a.tournamentRank - b.tournamentRank);
const myTeamCodes = myTeams.map(t => t.id);
const scoreData = calculatePlayerScore(playerName);

// Count active teams
const activeTeamsCount = myTeams.filter(t => t.status !== 'eliminated').length;

// 4. Filter matches involving this player's teams
const myMatches = matches.filter(m => 
	myTeamCodes.includes(m.homeTeamCode) || myTeamCodes.includes(m.awayTeamCode)
);

// 5. Calculate "Next Match Day" logic
const now = new Date();
const scheduledMatches = myMatches
	.filter(m => m.status === 'scheduled' && new Date(m.kickoffUtc) > now)
	.sort((a, b) => new Date(a.kickoffUtc).getTime() - new Date(b.kickoffUtc).getTime());

let nextMatchDayMatches: typeof matches = [];
let daysAwayText = "No upcoming matches";

if (scheduledMatches.length > 0) {
	// Find the date of the very next match
	const nextDate = new Date(scheduledMatches[0].kickoffUtc);
	const nextDateString = nextDate.toDateString();
	
	// Group ALL matches that happen on that exact same day for this player
	nextMatchDayMatches = scheduledMatches.filter(m => 
		new Date(m.kickoffUtc).toDateString() === nextDateString
	);

	// Calculate "Days Away" based on the start of the day
	const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
	const matchDay = new Date(nextDate.getFullYear(), nextDate.getMonth(), nextDate.getDate());
	const diffTime = Math.abs(matchDay.getTime() - today.getTime());
	const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)); 

	if (diffDays === 0) daysAwayText = "Today";
	else if (diffDays === 1) daysAwayText = "Tomorrow";
	else daysAwayText = `In ${diffDays} days`;
}

// Helper to format match times
const formatTime = (dateString: string) => {
  return new Date(dateString).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${playerName}'s Dashboard | World Cup Sweepstake`} description={`Personal dashboard and upcoming fixtures for ${playerName}.`} />
		<style>
			.page-header { text-align: center; margin-bottom: 3rem; }
			.back-link { display: inline-block; margin-bottom: 2rem; color: #0ea5e9; text-decoration: none; font-weight: 600; }
			.back-link:hover { text-decoration: underline; }
			
			/* Top Stats Grid */
			.top-stats-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 2rem;
				margin-bottom: 2rem;
			}
			@media (max-width: 600px) {
				.top-stats-grid { grid-template-columns: 1fr; gap: 1rem; }
			}

			.score-card {
				background: #ffffff;
				border: 1px solid #e2e8f0;
				border-radius: 12px;
				padding: 1.5rem;
				text-align: center;
				box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
			}
			.score-card h3 { margin-top: 0; font-size: 1.2rem; color: #475569; }
			.huge-score { font-size: 3.5rem; font-weight: bold; color: #0f172a; line-height: 1; margin: 1rem 0; }
			.score-label { color: #64748b; font-size: 0.9rem; }

			/* Up Next Section */
			.up-next-section {
				background: #f8fafc;
				border: 2px solid #e2e8f0;
				border-radius: 12px;
				padding: 2rem;
				margin-bottom: 4rem;
			}
			.up-next-header {
				display: flex;
				justify-content: space-between;
				align-items: flex-end;
				border-bottom: 2px solid #cbd5e1;
				padding-bottom: 1rem;
				margin-bottom: 1.5rem;
			}
			.up-next-header h2 { margin: 0; color: #0f172a; }
			.days-away {
				background: #0f172a;
				color: white;
				padding: 0.4rem 0.8rem;
				border-radius: 6px;
				font-size: 0.9rem;
				font-weight: bold;
			}

			/* Match Row UI */
			.match-row {
				background: white;
				border: 1px solid #cbd5e1;
				border-radius: 8px;
				padding: 1rem 1.5rem;
				margin-bottom: 0.75rem;
				display: flex;
				justify-content: space-between;
				align-items: center;
				box-shadow: 0 1px 2px rgba(0,0,0,0.05);
			}
			.match-row-time { 
				font-weight: bold; 
				color: #3b82f6; 
				width: 80px; 
				white-space: nowrap; 
				flex-shrink: 0; 
			}
			.match-row-teams { 
				flex: 1; 
				display: flex; 
				justify-content: center;
				align-items: center;
				gap: 1rem;
				font-size: 1.1rem; 
				font-weight: 600; 
			}
			.team-with-owner {
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}
			.match-vs {
				color: #94a3b8;
				font-size: 0.9rem;
				font-weight: normal;
				padding: 0 0.5rem;
			}
			.match-row-group { 
				width: 80px; 
				text-align: right; 
				color: #64748b; 
				font-size: 0.85rem; 
				text-transform: uppercase; 
			}

			/* Owner Tags */
			.owner-tag {
				font-size: 0.65rem;
				padding: 0.15rem 0.4rem;
				border-radius: 4px;
				text-transform: uppercase;
				font-weight: bold;
			}
			.owner-keenan { background: #e0feec; color: #0d9488; }
			.owner-poppie { background: #fce7f3; color: #be185d; }
			
			/* My Teams Grid */
			.my-teams-header { margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 2px solid #e2e8f0; padding-bottom: 0.5rem; }
			.teams-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
				gap: 1.5rem;
			}

			@media (max-width: 700px) {
				.match-row { flex-direction: column; gap: 0.5rem; text-align: center; }
				.match-row-time, .match-row-group { width: auto; text-align: center; }
				.match-row-teams { flex-direction: column; gap: 0.25rem; }
				.match-vs { display: none; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<a href="/worldcup" class="back-link">&larr; Back to Hub</a>
			
			<div class="page-header">
				<h1>{playerName}'s Dashboard</h1>
				<p>Your sweepstake command centre.</p>
			</div>

			<div class="top-stats-grid">
				<div class="score-card">
					<h3>Total Points</h3>
					<div class="huge-score">{scoreData.totalPoints}</div>
					<div class="score-label">Across all 24 teams</div>
				</div>
				<div class="score-card">
					<h3>Teams Remaining</h3>
					<div class="huge-score">{activeTeamsCount}</div>
					<div class="score-label">Active in Tournament</div>
				</div>
			</div>

			<div class="up-next-section">
				<div class="up-next-header">
					<h2>Up Next</h2>
					<span class="days-away">{daysAwayText}</span>
				</div>

				{nextMatchDayMatches.length === 0 ? (
					<p>No upcoming matches scheduled.</p>
				) : (
					nextMatchDayMatches.map(match => {
						const homeTeam = teams.find(t => t.id === match.homeTeamCode);
						const awayTeam = teams.find(t => t.id === match.awayTeamCode);

						return (
							<div class="match-row">
								<div class="match-row-time">{formatTime(match.kickoffUtc)}</div>
								
								<div class="match-row-teams">
									<div class="team-with-owner">
										<Country code={match.homeTeamCode} name={homeTeam?.name || match.homeTeamCode} />
										{homeTeam && <span class={`owner-tag owner-${homeTeam.owner.toLowerCase()}`}>{homeTeam.owner.charAt(0)}</span>}
									</div>
	
									<span class="match-vs">vs</span>
	
									<div class="team-with-owner">
										{awayTeam && <span class={`owner-tag owner-${awayTeam.owner.toLowerCase()}`}>{awayTeam.owner.charAt(0)}</span>}
										<Country code={match.awayTeamCode} name={awayTeam?.name || match.awayTeamCode} reverse={true} />
									</div>
								</div>

								<div class="match-row-group">
									{match.stage === 'group' ? `Grp ${match.group}` : match.stage.replace(/_/g, ' ')}
								</div>
							</div>
						)
					})
				)}
			</div>

			<h2 class="my-teams-header">Points Breakdown</h2>
			<div class="points-table-wrapper" style="overflow-x: auto; margin-bottom: 3rem;">
				<table style="width: 100%; border-collapse: collapse; text-align: left; background: white; border: 1px solid #e2e8f0; border-radius: 8px;">
					<thead style="background: #f8fafc; border-bottom: 2px solid #e2e8f0;">
						<tr>
							<th style="padding: 1rem;">Team</th>
							<th style="padding: 1rem; text-align: center;">W</th>
							<th style="padding: 1rem; text-align: center;">D</th>
							<th style="padding: 1rem; text-align: center;">Goals</th>
							<th style="padding: 1rem; text-align: center;">Clean Sheets</th>
							<th style="padding: 1rem; text-align: right; font-weight: 800; color: #0f172a;">Pts</th>
						</tr>
					</thead>
					<tbody>
						{scoreData.teamBreakdowns.map((team) => (
							<tr style="border-bottom: 1px solid #f1f5f9;">
								<td style="padding: 1rem; font-weight: bold; color: #334155;">{team.teamName}</td>
								<td style="padding: 1rem; text-align: center; color: #64748b;">{team.wins}</td>
								<td style="padding: 1rem; text-align: center; color: #64748b;">{team.draws}</td>
								<td style="padding: 1rem; text-align: center; color: #64748b;">{team.goals}</td>
								<td style="padding: 1rem; text-align: center; color: #64748b;">{team.cleanSheets}</td>
								<td style="padding: 1rem; text-align: right; font-weight: 800; color: #3b82f6; font-size: 1.1rem;">
									{team.totalPoints}
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>

			<h2 class="my-teams-header">My Squad</h2>
			<div class="teams-grid">
				{myTeams.map(team => (
					<TeamCard team={team} />
				))}
			</div>

		</main>
		<Footer />
	</body>
</html>