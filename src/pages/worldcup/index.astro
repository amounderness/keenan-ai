---
// src/pages/worldcup/index.astro
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getRankSummary } from '../../data/worldcup/teams';
import { calculatePlayerScore } from '../../data/worldcup/scoring';
import { teams } from '../../data/worldcup/teams';

const keenanStats = getRankSummary('Keenan');
const poppieStats = getRankSummary('Poppie');

const keenanScore = calculatePlayerScore('Keenan');
const poppieScore = calculatePlayerScore('Poppie');

let leader = 'tie';
let leaderText = "It's a tie!";

if (keenanScore.totalPoints > poppieScore.totalPoints) {
	leader = 'keenan';
	leaderText = "🏆 Keenan is in the lead!";
} else if (poppieScore.totalPoints > keenanScore.totalPoints) {
	leader = 'poppie';
	leaderText = "🏆 Poppie is in the lead!";
}

const keenanActive = teams.filter(t => t.owner === 'Keenan' && t.status !== 'eliminated').length;
const poppieActive = teams.filter(t => t.owner === 'Poppie' && t.status !== 'eliminated').length;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="World Cup Sweepstake | Keenan Clough" description="The official hub for our 2026 World Cup Sweepstake." />
		<style>
			.dashboard-header {
				text-align: center;
				margin-bottom: 3rem;
			}
			.dashboard-header h1 {
				margin-bottom: 0.5rem;
			}
			.stats-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
				gap: 2rem;
				margin-bottom: 4rem;
			}
			.stat-card {
				background: #ffffff;
				border: 1px solid #e2e8f0;
				border-radius: 12px;
				padding: 1.5rem;
				box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
			}
			.stat-card h2 {
				margin-top: 0;
				border-bottom: 2px solid #f1f5f9;
				padding-bottom: 0.75rem;
				font-size: 1.5rem;
			}
			.stat-row {
				display: flex;
				justify-content: space-between;
				padding: 0.75rem 0;
				border-bottom: 1px solid #f1f5f9;
			}
			.stat-row:last-child {
				border-bottom: none;
			}
			.stat-label {
				font-weight: 600;
				color: #475569;
			}
			.stat-value {
				color: #0f172a;
				font-weight: bold;
			}
			.nav-section h3 {
				text-align: center;
				margin-bottom: 1.5rem;
			}
			.nav-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
				gap: 1rem;
			}
			.nav-card {
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				padding: 1.5rem;
				background: #f8fafc;
				border: 2px solid #cbd5e1;
				border-radius: 8px;
				text-decoration: none;
				color: #334155;
				transition: all 0.2s ease;
				text-align: center;
			}
			.nav-card:hover:not(.disabled) {
				background: #0f172a;
				border-color: #0f172a;
				color: #ffffff;
			}
			.nav-card:hover:not(.disabled) .nav-desc {
				color: #cbd5e1;
			}
			.nav-card.disabled {
				opacity: 0.5;
				cursor: not-allowed;
				background: #f1f5f9;
			}
			.nav-title {
				font-weight: bold;
				font-size: 1.1rem;
				margin-bottom: 0.25rem;
			}
			.nav-desc {
				font-size: 0.85rem;
				color: #64748b;
			}

			/* Leaderboard Banner Styles */
			.leaderboard-banner {
				background: #0f172a;
				color: white;
				border-radius: 12px;
				padding: 2rem;
				margin-bottom: 3rem;
				text-align: center;
				box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
			}
			.leaderboard-banner h2 {
				margin-top: 0;
				color: #e2e8f0;
				font-size: 1.2rem;
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}
			.scores-display {
				display: flex;
				justify-content: center;
				align-items: center;
				gap: 2rem;
				margin: 1.5rem 0;
			}
			.score-box {
				display: flex;
				flex-direction: column;
				padding: 1rem 2rem;
				border-radius: 8px;
				background: rgba(255, 255, 255, 0.05);
				border: 2px solid rgba(255, 255, 255, 0.1); /* Default low-contrast border for ties */
				min-width: 150px;
				transition: all 0.2s ease;
			}
			.survival-strip {
				display: flex;
				justify-content: center;
				gap: 2rem;
				margin-top: 1rem;
			}
			.survival-badge {
				background: rgba(255, 255, 255, 0.1);
				padding: 0.5rem 1rem;
				border-radius: 99px;
				font-size: 0.9rem;
				color: #e2e8f0;
				display: flex;
				gap: 0.5rem;
				align-items: center;
			}
			.survival-count {
				font-weight: 800;
				color: #fff;
			}

			/* Permanent Text Colors per Player */
			.score-box.keenan-box .player-name,
			.score-box.keenan-box .player-points {
				color: #0d9488; /* Green text always */
			}
			.score-box.poppie-box .player-name,
			.score-box.poppie-box .player-points {
				color: #f472b6; /* Pink text always */
			}

			/* Conditional Container Highlights for the Leader */
			.score-box.leader.keenan-box {
				background: rgba(32, 233, 14, 0.15);
				border-color: #0d9488; /* Light Green border */
				transform: scale(1.05);
			}
			.score-box.leader.poppie-box {
				background: rgba(236, 72, 153, 0.15);
				border-color: #ec4899; /* Pink border */
				transform: scale(1.05);
			}

			.vs-badge {
				font-weight: bold;
				color: #475569;
				font-size: 1.2rem;
			}

			/* Dynamic Leader Text Bottom Alignment */
			.leader-text {
				font-weight: bold;
				margin: 0;
				font-size: 1.2rem;
				transition: color 0.2s ease;
			}
			.text-keenan { color: #0d9488; }
			.text-poppie { color: #f472b6; }
			.text-tie { color: #cbd5e1; } /* Muted grey for drawing state */

			@media (max-width: 600px) {
				.scores-display { gap: 1rem; }
				.score-box { min-width: 120px; padding: 1rem; }
				.player-points { font-size: 2.5rem; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="dashboard-header">
				<h1>World Cup 2026 Sweepstake</h1>
				<p>The official tracking hub for our tournament draft. Fair, balanced, and ready for kick-off.</p>
			</div>

			<div class="leaderboard-banner">
				<h2>Global Leaderboard</h2>
				<div class="scores-display">
					<div class={`score-box keenan-box ${leader === 'keenan' ? 'leader' : ''}`}>
						<span class="player-name">Keenan</span>
						<span class="player-points">{keenanScore.totalPoints}</span>
					</div>
					<div class="vs-badge">VS</div>
					<div class={`score-box poppie-box ${leader === 'poppie' ? 'leader' : ''}`}>
						<span class="player-name">Poppie</span>
						<span class="player-points">{poppieScore.totalPoints}</span>
					</div>
				</div>
				<p class={`leader-text text-${leader}`}>{leaderText}</p>
				<!-- Inside .leaderboard-banner, right below the <p class="leader-text"> -->
			<div class="survival-strip">
				<div class="survival-badge">
					<span>Keenan's Active Squad:</span>
					<span class="survival-count">{keenanActive} / 24</span>
				</div>
				<div class="survival-badge">
					<span>Poppie's Active Squad:</span>
					<span class="survival-count">{poppieActive} / 24</span>
				</div>
			</div>

			<div class="stats-grid">
				<div class="stat-card">
					<h2>Keenan's Allocation</h2>
					<div class="stat-row">
						<span class="stat-label">Total Teams</span>
						<span class="stat-value">{keenanStats.totalTeams}</span>
					</div>
					<div class="stat-row">
						<span class="stat-label">Average World Rank</span>
						<span class="stat-value">{keenanStats.averageWorldRank}</span>
					</div>
					<div class="stat-row">
						<span class="stat-label">Tier 1 Teams</span>
						<span class="stat-value">{keenanStats.topTierCount}</span>
					</div>
					<div class="stat-row">
						<span class="stat-label">Best / Worst Rank</span>
						<span class="stat-value">#{keenanStats.bestRank} / #{keenanStats.worstRank}</span>
					</div>
				</div>

				<div class="stat-card">
					<h2>Poppie's Allocation</h2>
					<div class="stat-row">
						<span class="stat-label">Total Teams</span>
						<span class="stat-value">{poppieStats.totalTeams}</span>
					</div>
					<div class="stat-row">
						<span class="stat-label">Average World Rank</span>
						<span class="stat-value">{poppieStats.averageWorldRank}</span>
					</div>
					<div class="stat-row">
						<span class="stat-label">Tier 1 Teams</span>
						<span class="stat-value">{poppieStats.topTierCount}</span>
					</div>
					<div class="stat-row">
						<span class="stat-label">Best / Worst Rank</span>
						<span class="stat-value">#{poppieStats.bestRank} / #{poppieStats.worstRank}</span>
					</div>
				</div>
			</div>

			<div class="nav-section">
				<h3>Tournament Hub</h3>
				<div class="nav-grid">
					<a href="/worldcup/sweepstake" class="nav-card">
						<span class="nav-title">The Sweepstake</span>
						<span class="nav-desc">Allocation & Fairness</span>
					</a>
					<a href="/worldcup/players/keenan" class="nav-card">
						<span class="nav-title">Keenan's Hub</span>
						<span class="nav-desc">View Dashboard</span>
					</a>
					<a href="/worldcup/players/poppie" class="nav-card">
						<span class="nav-title">Poppie's Hub</span>
						<span class="nav-desc">View Dashboard</span>
					</a>
					<a href="/worldcup/groups" class="nav-card">
						<span class="nav-title">Tournament Groups</span>
						<span class="nav-desc">A-L Standings</span>
					</a>
					<a href="/worldcup/teams" class="nav-card">
						<span class="nav-title">Team Directory</span>
						<span class="nav-desc">All 48 Nations</span>
					</a>
					<a href="/worldcup/fixtures" class="nav-card">
						<span class="nav-title">Fixtures & Results</span>
						<span class="nav-desc">Match Tracker</span>
					</a>
					<a href="/worldcup/standings" class="nav-card">
						<span class="nav-title">Overall Standings</span>
						<span class="nav-desc">Group Tables</span>
					</a>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>