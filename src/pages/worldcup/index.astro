---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getRankSummary } from '../../data/worldcup/teams';

const keenanStats = getRankSummary('Keenan');
const poppieStats = getRankSummary('Poppie');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="World Cup Sweepstake | Keenan Clough" description="The official hub for our 2026 World Cup Sweepstake." />
		<style>
			.dashboard-header {
				text-align: center;
				margin-bottom: 3rem;
			}
			.dashboard-header h1 {
				margin-bottom: 0.5rem;
			}
			.stats-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
				gap: 2rem;
				margin-bottom: 4rem;
			}
			.stat-card {
				background: #ffffff;
				border: 1px solid #e2e8f0;
				border-radius: 12px;
				padding: 1.5rem;
				box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
			}
			.stat-card h2 {
				margin-top: 0;
				border-bottom: 2px solid #f1f5f9;
				padding-bottom: 0.75rem;
				font-size: 1.5rem;
			}
			.stat-row {
				display: flex;
				justify-content: space-between;
				padding: 0.75rem 0;
				border-bottom: 1px solid #f1f5f9;
			}
			.stat-row:last-child {
				border-bottom: none;
			}
			.stat-label {
				font-weight: 600;
				color: #475569;
			}
			.stat-value {
				color: #0f172a;
				font-weight: bold;
			}
			.nav-section h3 {
				text-align: center;
				margin-bottom: 1.5rem;
			}
			.nav-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
				gap: 1rem;
			}
			.nav-card {
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 1.5rem;
				background: #f8fafc;
				border: 2px solid #cbd5e1;
				border-radius: 8px;
				text-decoration: none;
				color: #334155;
				font-weight: bold;
				transition: all 0.2s ease;
				text-align: center;
			}
			.nav-card:hover:not(.disabled) {
				background: #0f172a;
				border-color: #0f172a;
				color: #ffffff;
			}
			.nav-card.disabled {
				opacity: 0.5;
				cursor: not-allowed;
				background: #f1f5f9;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="dashboard-header">
				<h1>World Cup 2026 Sweepstake</h1>
				<p>The official tracking hub for our tournament draft. Fair, balanced, and ready for kick-off.</p>
			</div>

			<div class="stats-grid">
				<div class="stat-card">
					<h2>Keenan's Allocation</h2>
					<div class="stat-row">
						<span class="stat-label">Total Teams</span>
						<span class="stat-value">{keenanStats.totalTeams}</span>
					</div>
					<div class="stat-row">
						<span class="stat-label">Average World Rank</span>
						<span class="stat-value">{keenanStats.averageWorldRank}</span>
					</div>
					<div class="stat-row">
						<span class="stat-label">Tier 1 Teams</span>
						<span class="stat-value">{keenanStats.topTierCount}</span>
					</div>
					<div class="stat-row">
						<span class="stat-label">Best / Worst Rank</span>
						<span class="stat-value">#{keenanStats.bestRank} / #{keenanStats.worstRank}</span>
					</div>
				</div>

				<div class="stat-card">
					<h2>Poppie's Allocation</h2>
					<div class="stat-row">
						<span class="stat-label">Total Teams</span>
						<span class="stat-value">{poppieStats.totalTeams}</span>
					</div>
					<div class="stat-row">
						<span class="stat-label">Average World Rank</span>
						<span class="stat-value">{poppieStats.averageWorldRank}</span>
					</div>
					<div class="stat-row">
						<span class="stat-label">Tier 1 Teams</span>
						<span class="stat-value">{poppieStats.topTierCount}</span>
					</div>
					<div class="stat-row">
						<span class="stat-label">Best / Worst Rank</span>
						<span class="stat-value">#{poppieStats.bestRank} / #{poppieStats.worstRank}</span>
					</div>
				</div>
			</div>

			<div class="nav-section">
				<h3>Tournament Hub</h3>
				<div class="nav-grid">
					<a href="/worldcup/groups" class="nav-card">View All Groups</a>
					<div class="nav-card disabled" title="Coming in Phase 2">Fixtures (Phase 2)</div>
					<div class="nav-card disabled" title="Coming in Phase 3">Standings (Phase 3)</div>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>