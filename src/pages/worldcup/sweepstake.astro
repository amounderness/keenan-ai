---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TeamCard from '../../components/worldcup/TeamCard.astro';
import { getTeamsByOwner, getRankSummary } from '../../data/worldcup/teams';

const keenanTeams = getTeamsByOwner('Keenan').sort((a, b) => a.worldRank - b.worldRank);
const poppieTeams = getTeamsByOwner('Poppie').sort((a, b) => a.worldRank - b.worldRank);
const keenanStats = getRankSummary('Keenan');
const poppieStats = getRankSummary('Poppie');

const tiers = [1, 2, 3, 4, 5, 6];
const countTiers = (teams: any[], tier: number) => teams.filter(t => t.tier === tier).length;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Sweepstake Allocation | World Cup Tracker" description="Full allocation and fairness methodology." />
		<style>
			.page-header {
				text-align: center;
				margin-bottom: 3rem;
			}
			.back-link {
				display: inline-block;
				margin-bottom: 2rem;
				color: #0ea5e9;
				text-decoration: none;
				font-weight: 600;
			}
			.back-link:hover {
				text-decoration: underline;
			}
			.methodology {
				background: #f8fafc;
				padding: 1.5rem;
				border-radius: 8px;
				border-left: 4px solid #3b82f6;
				margin-bottom: 3rem;
			}
			.fairness-panel {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
				gap: 1.5rem;
				margin-bottom: 4rem;
			}
			.fairness-card {
				background: white;
				border: 1px solid #e2e8f0;
				padding: 1.5rem;
				border-radius: 8px;
				text-align: center;
			}
			.allocations-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 2rem;
			}
			@media (max-width: 768px) {
				.allocations-grid {
					grid-template-columns: 1fr;
				}
			}
			.player-column h2 {
				text-align: center;
				padding-bottom: 1rem;
				border-bottom: 2px solid #e2e8f0;
				margin-bottom: 1.5rem;
			}
			.team-list {
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<a href="/worldcup" class="back-link">&larr; Back to Hub</a>
			
			<div class="page-header">
				<h1>The Sweepstake</h1>
				<p>Allocation breakdown and balance statistics.</p>
			</div>

			<div class="methodology">
				<h3>Methodology</h3>
				<p>To ensure a balanced draw, the 48 teams were split into 6 competitive tiers based on their tournament rank. Teams were allocated randomly within those tiers, followed by a programmatic balancing pass to ensure every single group contains exactly two teams for each player. The result is seemingly a near-perfect balance.</p>
			</div>

			<h2>Balance Statistics</h2>
			<div class="fairness-panel">
				<div class="fairness-card">
					<h4>Total Teams</h4>
					<p>Keenan: 24 Poppie: 24</p>
					<small>Perfect Split</small>
				</div>
				<div class="fairness-card">
					<h4>Group Split</h4>
					<p>2 per group each A-L</p>
					<small>Perfect Split</small>
				</div>
				<div class="fairness-card">
					<h4>Draw Tiers</h4>
					<p>4 from each tier 1-6</p>
					<small>Perfect Split</small>
				</div>
				<div class="fairness-card">
					<h4>Rank Total</h4>
					<p>Keenan: 585 Poppie: 591</p>
					<small>Near-Perfect Split</small>
				</div>
			</div>

			<div class="allocations-grid">
				<div class="player-column">
					<h2>Keenan's Teams</h2>
					<div class="team-list">
						{keenanTeams.map((team) => (
							<TeamCard team={team} />
						))}
					</div>
				</div>

				<div class="player-column">
					<h2>Poppie's Teams</h2>
					<div class="team-list">
						{poppieTeams.map((team) => (
							<TeamCard team={team} />
						))}
					</div>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>